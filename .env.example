# ─── PayPal Sandbox Credentials ──────────────────────────────────────────────
# Obtain from PayPal Developer Dashboard -> Apps & Credentials (Sandbox)
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET

# ─── Google Gemini API Key ───────────────────────────────────────────────────
# Obtain from Google AI Studio -> Get API Key
# https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# ─── Server Port ─────────────────────────────────────────────────────────────
PORT=3000

# For a US Personal Sandbox buyer (set to the buyer account country if different).
# This affects SDK testing only, not production PayPal API requests.
PAYPAL_SANDBOX_BUYER_COUNTRY=US
# Defaults to local-only for safety. Public demo hosting requires authentication first.
HOST=127.0.0.1
